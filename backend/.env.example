# Kredensial LiveKit (harus sama dengan LIVEKIT_KEYS di livekit/livekit.yaml)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# URL WebSocket LiveKit yang dikirim ke browser lewat /api/token.
#   Dev (LiveKit --dev langsung)     : ws://localhost:7880
#   Dev (lewat proxy, path /livekit) : ws://localhost:5173/livekit
#   Production                       : wss://aws86.online/livekit
LIVEKIT_WS_URL=ws://localhost:7880

# Port HTTP token server
PORT=3001

# Origin frontend yang diizinkan (pisahkan koma)
#   Dev        : http://localhost:5173
#   Production : https://aws86.online
CORS_ORIGIN=http://localhost:5173

# Masa berlaku token (LiveKit duration string: "6h", "30m")
TOKEN_TTL=6h