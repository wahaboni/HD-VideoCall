# Template nginx untuk frontend.
# Variabel ${...} di bawah di-substitusi oleh entrypoint resmi image nginx
# (hanya nama yang cocok dengan NGINX_ENVSUBST_FILTER).
#
#   DOMAIN            - domain publik, dipakai untuk server_name
#   BACKEND_UPSTREAM  - host:port token server (default backend:3001)
#   LIVEKIT_UPSTREAM  - host:port LiveKit HTTP/WS (default livekit:7880)
#   NGINX_RESOLVER    - resolver Docker (127.0.0.11)
#
# LiveKit signalling selalu hidup di bawah /livekit/rtc (production) dan
# /rtc (kompatibilitas). Isi LIVEKIT_WS_URL=https://<domain>/livekit.

server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    root /usr/share/nginx/html;
    index index.html;

    # Resolve upstream lewat DNS Docker saat request, bukan sekali saat start.
    # Tanpa ini, nginx memakai IP lama dan balas 502 setelah container backend
    # di-restart / di-recreate oleh `docker compose up`.
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
    set $backend_upstream "${BACKEND_UPSTREAM}";
    set $livekit_upstream "${LIVEKIT_UPSTREAM}";

    # Upload/websocket-friendly
    client_max_body_size 4m;
    server_tokens off;

    # Kompresi aset statis.
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # ---- Health check (lokal, tidak bergantung backend) ----
    location = /healthz {
        access_log off;
        add_header Content-Type application/json always;
        return 200 '{"ok":true}';
    }

    # ---- Token server ----
    location /api/ {
        proxy_pass http://$backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_buffering off;
        add_header Cache-Control "no-store" always;
    }

    # ---- LiveKit signalling ----
    # LIVEKIT_WS_URL berakhir dengan path, mis. wss://aws86.online/livekit.
    # livekit-client lalu memanggil /livekit/rtc/v1 (WS) dan /livekit/rtc/validate.
    # Kedua path diarahkan ke LiveKit tanpa prefix, jadi upstream menerima /rtc/...
    #
    # Catatan: proxy_pass dengan variabel tidak boleh memakai URI, karena itu
    # prefix dibuang lewat rewrite (break = tidak lanjut ke location lain).
    location /livekit/rtc {
        rewrite ^/livekit(/rtc.*)$ $1 break;
        proxy_pass http://$livekit_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Sesi meeting bisa berjalan lama.
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_buffering off;
    }

    # Kompatibilitas: LIVEKIT_WS_URL tanpa path (ws://localhost:7880).
    location /rtc {
        rewrite ^/rtc(.*)$ /rtc$1 break;
        proxy_pass http://$livekit_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_buffering off;
    }

    # ---- Aset dengan hash: cache panjang ----
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        try_files $uri =404;
    }

    # ---- Runtime config: jangan pernah di-cache ----
    location = /config.js {
        add_header Cache-Control "no-store" always;
        try_files $uri =404;
    }

    # ---- SPA fallback ----
    location / {
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}