# Nginx host sebagai TLS terminator di depan docker compose (opsional).
#
# Alur:
#   Internet :443 -> nginx host (TLS) -> 127.0.0.1:8080 (container frontend)
#
# Syarat:
#   - .env: FRONTEND_PORT=8080 (jangan 80, supaya nginx host yang pegang 80/443)
#   - .env: LIVEKIT_WS_URL=wss://video.example.com
#   - .env: CORS_ORIGIN=https://video.example.com
#   - Sertifikat: sudo certbot --nginx -d video.example.com
#
# Simpan sebagai /etc/nginx/sites-available/hdvc lalu symlink ke sites-enabled.

upstream hdvc_frontend {
    server 127.0.0.1:8080;
    keepalive 16;
}

# --- HTTP: hanya untuk challenge ACME + redirect ---------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name video.example.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# --- HTTPS ----------------------------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name video.example.com;

    ssl_certificate     /etc/letsencrypt/live/video.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/video.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    client_max_body_size 4m;

    # WebSocket signalling LiveKit harus tetap terbuka lama.
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;

    location / {
        proxy_pass http://hdvc_frontend;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_buffering off;
    }
}

# Peta upgrade WebSocket. Taruh di http{} bila nginx host tidak memilikinya.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# CATATAN: media WebRTC TIDAK lewat nginx HTTP. Pakai port UDP 50000-50040
# langsung ke IP publik VPS. Lihat README bagian firewall.