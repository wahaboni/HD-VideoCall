# ============================================================================
# HD Video Call — konfigurasi Docker Compose
# Salin ke .env lalu isi nilainya:  cp .env.example .env
#
# Semua URL di bawah dipakai saat container start, jadi cukup ubah file ini
# lalu `docker compose up -d` (TANPA rebuild) ketika pindah ke VPS.
# ============================================================================

# Domain publik (tanpa https://). Dipakai nginx server_name.
DOMAIN=aws86.online

# ------------------------------------------------------------------ LiveKit
# Ganti dengan nilai acak kuat sebelum deploy:
#   openssl rand -hex 24
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# URL LiveKit yang dikirim ke browser lewat /api/token.
# Path /livekit diproxy nginx ke container livekit (client lalu memanggil
# /livekit/rtc/v1). Port 7880 TIDAK diekspos ke publik.
#   Production : wss://aws86.online/livekit
#   Dev lokal  : ws://localhost:8080/livekit  (atau ws://localhost:7880 langsung)
LIVEKIT_WS_URL=wss://aws86.online/livekit

# ------------------------------------------------------------------ Backend
# URL token server yang dipakai browser (runtime config /config.js).
#   Production : https://aws86.online        (nginx -> /api -> backend)
#   Dev lokal  : http://localhost:8080       (atau kosong = same-origin)
VITE_API_URL=https://aws86.online

# Origin frontend yang diizinkan (CORS), pisahkan koma bila lebih dari satu.
CORS_ORIGIN=https://aws86.online

# Token berlaku 6 jam; sesi lebih panjang akan minta token baru.
TOKEN_TTL=6h

# ------------------------------------------------------------------ Ports
# Port HTTP host yang dipetakan ke nginx container.
# 80 langsung bila VPS khusus aplikasi ini. Pakai 8080 bila nginx host
# yang memegang 80/443 (lihat livekit/nginx-stream.conf.example).
FRONTEND_PORT=80

# Port UDP media LiveKit (host -> container). Harus sama dengan
# rtc.udp_port di livekit/livekit.yaml. WAJIB dibuka di firewall VPS.
LIVEKIT_UDP_RANGE=50000-50040

# Port ICE/TCP fallback (harus terbuka juga di firewall).
LIVEKIT_TCP_PORT=7881